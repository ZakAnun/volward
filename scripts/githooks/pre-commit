#!/usr/bin/env bash
# Format staged Dart under apps/volward so CI's dart format check cannot fail.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

fvm_config_changes=()
while IFS= read -r f; do
  [[ -n "$f" ]] && fvm_config_changes+=("$f")
done <<EOF
$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^apps/volward/(\.fvmrc|\.fvm/fvm_config\.json)$' || true)
EOF
if [[ ${#fvm_config_changes[@]} -gt 0 ]]; then
  echo "error: do not commit FVM config changes (${fvm_config_changes[*]})." >&2
  echo "Project Flutter SDK must stay on stable. Run: bash scripts/ensure_fvm_stable.sh" >&2
  exit 1
fi

staged=()
while IFS= read -r f; do
  [[ -n "$f" ]] && staged+=("$f")
done <<EOF
$(git diff --cached --name-only --diff-filter=ACMR | grep '\.dart$' || true)
EOF
if [[ ${#staged[@]} -eq 0 ]]; then
  exit 0
fi

rel_files=()
for f in "${staged[@]}"; do
  case "$f" in
    apps/volward/*) rel_files+=("${f#apps/volward/}") ;;
  esac
done
if [[ ${#rel_files[@]} -eq 0 ]]; then
  exit 0
fi

cd "$repo_root/apps/volward"
if command -v fvm >/dev/null 2>&1; then
  fvm dart format "${rel_files[@]}"
else
  dart format "${rel_files[@]}"
fi

cd "$repo_root"
for f in "${staged[@]}"; do
  case "$f" in
    apps/volward/*) git add -- "$f" ;;
  esac
done
