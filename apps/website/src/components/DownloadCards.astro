---
import DownloadPanel from './DownloadPanel.astro';
import type { DownloadAsset } from '../lib/site';

interface Props {
  title: string;
  lead: string;
  items: DownloadAsset[];
  latestHref: string;
  latestLabel: string;
  downloadPlatformAriaLabel: string;
}

const { title, lead, items, latestHref, latestLabel, downloadPlatformAriaLabel } = Astro.props;
---

<section class="download-section">
  <div class="shell">
    <p class="section-label">{title}</p>
    <p class="lede download-lead">{lead}</p>
    <DownloadPanel
      variant="section"
      items={items}
      latestHref={latestHref}
      latestLabel={latestLabel}
      downloadPlatformAriaLabel={downloadPlatformAriaLabel}
    />
  </div>
</section>
