---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  ctaPrimary: string;
  ctaPrimaryHref: string;
  ctaSecondary?: string;
  ctaSecondaryHref?: string;
  wordmarkSrc: string;
  logoSrc: string;
  dashboard: {
    volumeName: string;
    chooseFolder: string;
    targets: {
      home: string;
      applications: string;
      desktop: string;
      downloads: string;
      documents: string;
    };
    capacityPath: string;
    usedBytes: string;
    usedLabel: string;
    totalBytes: string;
    totalLabel: string;
    availableBytes: string;
    availableLabel: string;
    largestTitle: string;
    scannedLabel: string;
    largestItems: Array<{
      name: string;
      size: string;
      barWidth: string;
      kind: 'folder' | 'file';
    }>;
    categories: {
      cache: string;
      temp: string;
      media: string;
      system: string;
    };
    status: string;
    lastScan: string;
    reclaimable: string;
    browseFiles: string;
    startScan: string;
  };
  metaItems: string[];
}

const {
  eyebrow,
  title,
  lead,
  ctaPrimary,
  ctaSecondary,
  ctaPrimaryHref,
  ctaSecondaryHref,
  logoSrc,
  dashboard,
  metaItems,
} = Astro.props;
---

<section class="hero section">
  <div class="shell hero-shell">
    <div class="hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="title hero-title">{title}</h1>
      <p class="lede hero-lead">{lead}</p>
      <div class="button-row">
        <a class="button button-primary" href={ctaPrimaryHref}>{ctaPrimary}</a>
        {ctaSecondary && ctaSecondaryHref && (
          <a class="button button-ghost" href={ctaSecondaryHref}>{ctaSecondary}</a>
        )}
      </div>
      <div class="hero-meta" aria-label="Volward summary">
        {metaItems.map((item) => (
          <span class="hero-meta-pill">{item}</span>
        ))}
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="hero-dashboard">
        <div class="hero-topbar">
          <div class="hero-topbar-brand">
            <img src={logoSrc} alt="" />
            <span>Volward</span>
          </div>
          <div class="hero-topbar-actions">
            <div class="hero-volume-chip">
              <span class="hero-chip-icon hero-chip-storage"></span>
              <span>{dashboard.volumeName}</span>
              <span class="hero-chip-caret"></span>
            </div>
            <div class="hero-topbar-chip">
              <span class="hero-chip-icon hero-chip-folder"></span>
              <span>{dashboard.chooseFolder}</span>
            </div>
            <div class="hero-settings-dot"></div>
          </div>
        </div>

        <div class="hero-board">
          <aside class="hero-sidebar">
            <div class="hero-logo-wrap">
              <img src={logoSrc} alt="" />
            </div>
            <div class="hero-sidebar-list">
              <div class="hero-sidebar-item hero-sidebar-item-active"><span class="hero-target-icon hero-target-home"></span><span>{dashboard.targets.home}</span></div>
              <div class="hero-sidebar-item"><span class="hero-target-icon hero-target-apps"></span><span>{dashboard.targets.applications}</span></div>
              <div class="hero-sidebar-item"><span class="hero-target-icon hero-target-desktop"></span><span>{dashboard.targets.desktop}</span></div>
              <div class="hero-sidebar-item"><span class="hero-target-icon hero-target-downloads"></span><span>{dashboard.targets.downloads}</span></div>
              <div class="hero-sidebar-item"><span class="hero-target-icon hero-target-docs"></span><span>{dashboard.targets.documents}</span></div>
            </div>
          </aside>

          <div class="hero-main">
            <div class="hero-stat-panel">
              <div class="hero-capacity-path">{dashboard.capacityPath}</div>
              <div class="hero-stat-value">{dashboard.usedBytes}</div>
              <div class="hero-stat-label">{dashboard.usedLabel}</div>
              <div class="hero-capacity-metrics">
                <div>
                  <strong>{dashboard.totalBytes}</strong>
                  <span>{dashboard.totalLabel}</span>
                </div>
                <div>
                  <strong>{dashboard.availableBytes}</strong>
                  <span>{dashboard.availableLabel}</span>
                </div>
              </div>
              <div class="hero-meter" aria-hidden="true">
                <span></span>
              </div>
            </div>

            <div class="hero-panel hero-largest-panel">
              <div class="hero-panel-head">
                <strong>{dashboard.largestTitle}</strong>
                <span>{dashboard.scannedLabel}</span>
              </div>
              <div class="hero-largest-list">
                {dashboard.largestItems.map((item) => (
                  <div class="hero-largest-row">
                    <div class="hero-largest-title">
                      <span class={`hero-file-icon ${item.kind === 'folder' ? 'hero-file-folder' : 'hero-file-file'}`}></span>
                      <span>{item.name}</span>
                      <strong>{item.size}</strong>
                    </div>
                    <div class="hero-largest-bar"><span style={`width: ${item.barWidth}`}></span></div>
                  </div>
                ))}
              </div>
            </div>

            <div class="hero-panel hero-compose-panel">
              <div class="hero-category-side">
                <div class="hero-category-pie"></div>
                <div class="hero-category-list">
                  <div><span class="hero-category-dot hero-category-cache"></span><span>{dashboard.categories.cache}</span><strong>24%</strong></div>
                  <div><span class="hero-category-dot hero-category-temp"></span><span>{dashboard.categories.temp}</span><strong>8%</strong></div>
                  <div><span class="hero-category-dot hero-category-media"></span><span>{dashboard.categories.media}</span><strong>39%</strong></div>
                  <div><span class="hero-category-dot hero-category-system"></span><span>{dashboard.categories.system}</span><strong>18%</strong></div>
                </div>
              </div>
              <div class="hero-actions-side">
                <div class="hero-status-chip">{dashboard.status}</div>
                <div class="hero-scan-note">{dashboard.lastScan}</div>
                <div class="hero-reclaim-note">{dashboard.reclaimable}</div>
                <div class="hero-action-button hero-action-secondary"><span class="hero-chip-icon hero-chip-folder"></span><span>{dashboard.browseFiles}</span></div>
                <div class="hero-action-button hero-action-primary"><span class="hero-scan-icon"></span><span>{dashboard.startScan}</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
