---
import DownloadPanel from './DownloadPanel.astro';
import type { DownloadAsset, WorkflowStepCopy } from '../lib/site';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  scrollHint: string;
  featureTeasers: WorkflowStepCopy[];
  downloads: DownloadAsset[];
  latestHref: string;
  latestLabel: string;
  downloadPlatformAriaLabel: string;
}

const {
  eyebrow,
  title,
  lead,
  scrollHint,
  featureTeasers,
  downloads,
  latestHref,
  latestLabel,
  downloadPlatformAriaLabel,
} = Astro.props;

const stepIcons: Record<string, string> = {
  scan: '◎',
  browse: '▤',
  filter: '◑',
  clean: '⌫',
};
---

<section id="download" class="hero-landing" data-hero-landing>
  <div class="hero-landing-bg" aria-hidden="true"></div>

  <div class="hero-landing-body">
    <div class="hero-landing-upper shell">
      <div class="hero-landing-copy">
        <div class="hero-landing-text">
          <p class="hero-landing-eyebrow">{eyebrow}</p>
          <h1 class="hero-landing-title">{title}</h1>
          <p class="hero-landing-lead">{lead}</p>
        </div>

        <div class="hero-landing-download">
          <DownloadPanel
            variant="hero"
            items={downloads}
            latestHref={latestHref}
            latestLabel={latestLabel}
            downloadPlatformAriaLabel={downloadPlatformAriaLabel}
            showFootnote={false}
          />
        </div>

        <p class="hero-landing-release">
          <a href={latestHref}>{latestLabel}</a>
        </p>
      </div>
    </div>

    <div class="hero-landing-preview-zone shell">
      <div class="preview-slot preview-slot--hero" data-preview-slot="hero" aria-hidden="true"></div>
    </div>
  </div>

  <nav class="hero-teasers shell" aria-label={scrollHint}>
    {featureTeasers.map((step) => (
      <a href={`#tour-${step.id}`} class="hero-teaser" data-hero-tour-link={step.id}>
        <span class="hero-teaser-icon" aria-hidden="true">{stepIcons[step.id]}</span>
        <span class="hero-teaser-name">{step.shortName}</span>
      </a>
    ))}
  </nav>

  <a href="#features" class="hero-scroll-hint" aria-label={scrollHint} data-hero-features-link>
    <span class="hero-scroll-hint-icon" aria-hidden="true"></span>
  </a>
</section>

<script>
  import { animateScrollTo, resolveFeaturesScrollTop } from '../lib/hero-scroll';
  import { prefersReducedMotion, scrollToTourStep } from '../lib/product-tour';
  import type { WorkflowStepId } from '../lib/site';

  const hero = document.querySelector<HTMLElement>('[data-hero-landing]');
  const features = document.getElementById('features');
  const tourRoot = document.querySelector<HTMLElement>('[data-product-tour]');
  const reducedMotion = prefersReducedMotion();

  document.querySelectorAll<HTMLAnchorElement>('[data-hero-tour-link]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const step = link.dataset.heroTourLink as WorkflowStepId | undefined;
      if (step && tourRoot) {
        scrollToTourStep(tourRoot, step, reducedMotion);
        return;
      }
      if (features) {
        void animateScrollTo(resolveFeaturesScrollTop(features), { reducedMotion });
      }
    });
  });

  document.querySelector<HTMLAnchorElement>('[data-hero-features-link]')?.addEventListener('click', (event) => {
    if (!features) {
      return;
    }
    event.preventDefault();
    void animateScrollTo(resolveFeaturesScrollTop(features), { reducedMotion });
  });
</script>
