---
const col1 = [
  { name: 'Library', size: '132 GB', kind: 'folder' as const },
  { name: 'Caches', size: '18 GB', kind: 'folder' as const, active: true },
];

const col2 = [
  { name: 'com.apple.Safari', size: '2.4 GB', kind: 'folder' as const, active: true },
  { name: 'com.google.Chrome', size: '890 MB', kind: 'folder' as const },
  { name: 'com.apple.dt.Xcode', size: '4.8 GB', kind: 'folder' as const },
];

const col3 = [
  { name: 'Cache.db', size: '412 MB', kind: 'file' as const, active: true },
  { name: 'fsCachedData', size: '128 MB', kind: 'folder' as const },
  { name: 'WebKit', size: '96 MB', kind: 'folder' as const },
];
---

<div class="tour-browse-main">
  <div class="tour-column-view tour-column-view--filtered">
    <div class="tour-column">
      {col1.map((row) => (
        <div class={`tour-column-row ${row.active ? 'is-active' : ''}`}>
          <span class={`hero-file-icon ${row.kind === 'folder' ? 'hero-file-folder' : 'hero-file-file'}`}></span>
          <span>{row.name}</span>
          <strong>{row.size}</strong>
        </div>
      ))}
    </div>
    <div class="tour-column">
      {col2.map((row) => (
        <div class={`tour-column-row ${row.active ? 'is-active' : ''}`}>
          <span class={`hero-file-icon ${row.kind === 'folder' ? 'hero-file-folder' : 'hero-file-file'}`}></span>
          <span>{row.name}</span>
          <strong>{row.size}</strong>
        </div>
      ))}
    </div>
    <div class="tour-column">
      {col3.map((row) => (
        <div class={`tour-column-row ${row.active ? 'is-active' : ''}`}>
          <span class={`hero-file-icon ${row.kind === 'folder' ? 'hero-file-folder' : 'hero-file-file'}`}></span>
          <span>{row.name}</span>
          <strong>{row.size}</strong>
        </div>
      ))}
    </div>
  </div>
</div>
