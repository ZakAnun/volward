---
interface Props {
  class?: string;
  variant?: 'home' | 'browse';
}

const { class: className, variant = 'home' } = Astro.props;
---

<div class:list={['app-mockup-shell', `app-mockup-shell--${variant}`, className]}>
  {variant === 'home' ? (
    <div class="app-mockup-inner">
      <slot />
    </div>
  ) : (
    <slot />
  )}
</div>
