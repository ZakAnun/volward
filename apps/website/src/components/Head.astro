---
interface Props {
  title: string;
  description: string;
  canonical: string;
  lang: 'en' | 'zh';
  image?: string;
  alternates?: Array<{ lang: string; href: string }>;
}

const { title, description, canonical, lang, image = '/og/volward-share.svg', alternates = [] } = Astro.props;
const imageUrl = new URL(image, canonical).href;
const ext = image.split('.').pop()?.toLowerCase() ?? '';
const imageType = ext === 'png' ? 'image/png'
  : ext === 'jpg' || ext === 'jpeg' ? 'image/jpeg'
  : ext === 'webp' ? 'image/webp'
  : 'image/svg+xml';
const locale = lang === 'zh' ? 'zh_CN' : 'en_US';
const alternateLocales = alternates.map((item) => item.lang).filter((item) => item !== lang);
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index,follow" />
<link rel="icon" href="/branding/volward-logo.svg" type="image/svg+xml" />
<link rel="icon" href="/branding/volward-logo.png" type="image/png" />
<link rel="apple-touch-icon" href="/branding/volward-logo.png" />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Volward" />
<meta property="og:locale" content={locale} />
{alternateLocales.map((item) => (
  <meta property="og:locale:alternate" content={item === 'zh' ? 'zh_CN' : 'en_US'} />
))}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={title} />
<meta property="og:image:type" content={imageType} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={title} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#111113" media="(prefers-color-scheme: dark)" />
<link rel="alternate" hreflang="x-default" href={alternates.find((item) => item.lang === 'en')?.href ?? canonical} />
{alternates.map((item) => (
  <link rel="alternate" hreflang={item.lang} href={item.href} />
))}
<link rel="alternate" hreflang={lang} href={canonical} />
