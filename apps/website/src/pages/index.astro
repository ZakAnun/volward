---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import DownloadCards from '../components/DownloadCards.astro';
import Footer from '../components/Footer.astro';
import { DOWNLOADS, PAGE_COPY, LATEST_RELEASE_URL } from '../lib/site';

const copy = PAGE_COPY.en;
const downloads = DOWNLOADS.en;
const heroMetaItems = downloads.map((item) => item.label);
const canonical = new URL('./', Astro.site?.href ?? 'http://localhost:4321').href;
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonical={canonical}
  lang="en"
  alternates={[{ lang: 'zh', href: `${canonical}zh/` }]}
>
  <Nav
    homeHref="/"
    homeAriaLabel="Volward home"
    navAriaLabel="Primary"
    downloadLabel={copy.navDownload}
    localeToggleHref="/zh/"
    localeToggleLabel={copy.localeToggle}
    wordmarkSrc="/branding/volward-wordmark.png"
  />

  <main>
    <Hero
      eyebrow={copy.heroEyebrow}
      title={copy.heroTitle}
      lead={copy.heroLead}
      ctaPrimary={copy.ctaDownload}
      ctaPrimaryHref="#download"
      wordmarkSrc="/branding/volward-wordmark.png"
      logoSrc="/branding/volward-logo.png"
      metaItems={heroMetaItems}
    />
    <DownloadCards
      title={copy.downloadTitle}
      lead={copy.downloadLead}
      items={downloads}
      latestHref={LATEST_RELEASE_URL}
      latestLabel={copy.downloadAllReleases}
    />
  </main>

  <Footer copy={copy.footerCopy} versionText={copy.footerVersion} unsignedText={copy.footerUnsigned} version="" />
</BaseLayout>
