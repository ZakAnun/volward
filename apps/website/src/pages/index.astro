---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import AppPreviewLayer from '../components/AppPreviewLayer.astro';
import Hero from '../components/Hero.astro';
import HomePreviewBootstrap from '../components/HomePreviewBootstrap.astro';
import ProductTour from '../components/ProductTour.astro';
import ReleaseNotes from '../components/ReleaseNotes.astro';
import Footer from '../components/Footer.astro';
import { GITHUB_RELEASES_URL, PAGE_COPY } from '../lib/site';
import { resolveDownloads } from '../lib/release-downloads';
import { resolveReleaseLogs } from '../lib/release-logs';

const copy = PAGE_COPY.en;
const downloads = await resolveDownloads('en', { logger: console });
const releaseLogs = await resolveReleaseLogs('en', { logger: console });
const canonical = new URL('./', Astro.site?.href ?? 'http://localhost:4321').href;
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonical={canonical}
  lang="en"
  alternates={[{ lang: 'zh', href: `${canonical}zh/` }]}
>
  <Nav
    homeHref="/"
    homeAriaLabel="Volward home"
    navAriaLabel="Primary"
    featuresLabel={copy.navFeatures}
    downloadLabel={copy.navDownload}
    localeToggleHref="/zh/"
    localeToggleLabel={copy.localeToggle}
    logoSrc="/branding/volward-logo.svg"
  />

  <main class="page-main">
    <Hero
      eyebrow={copy.heroEyebrow}
      title={copy.heroTitle}
      lead={copy.heroLead}
      scrollHint={copy.heroScrollHint}
      featureTeasers={copy.productTour.steps}
      downloads={downloads}
      latestHref={GITHUB_RELEASES_URL}
      latestLabel={copy.downloadAllReleases}
      downloadPlatformAriaLabel={copy.downloadPlatformAriaLabel}
    />
    <AppPreviewLayer
      dashboard={copy.heroDashboard}
      labels={copy.productTour.mockupLabels}
      logoSrc="/branding/volward-logo.png"
    />
    <ProductTour copy={copy.productTour} />
    <ReleaseNotes title={copy.releaseLogTitle} items={releaseLogs} />
    <HomePreviewBootstrap />
  </main>

  <Footer copy={copy.footerCopy} versionText={copy.footerVersion} unsignedText={copy.footerUnsigned} version="" />
</BaseLayout>
