---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Features from '../../components/Features.astro';
import ReleaseNotes from '../../components/ReleaseNotes.astro';
import DownloadCards from '../../components/DownloadCards.astro';
import Footer from '../../components/Footer.astro';
import { GITHUB_RELEASES_URL, PAGE_COPY } from '../../lib/site';
import { resolveDownloads } from '../../lib/release-downloads';
import { resolveReleaseLogs } from '../../lib/release-logs';

const copy = PAGE_COPY.zh;
const downloads = await resolveDownloads('zh', { logger: console });
const releaseLogs = await resolveReleaseLogs('zh', { logger: console });
const heroMetaItems = downloads.map((item) => item.label);
const canonical = new URL('zh/', Astro.site?.href ?? 'http://localhost:4321').href;
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonical={canonical}
  lang="zh"
  alternates={[{ lang: 'en', href: new URL('../', canonical).href }]}
>
  <Nav
    homeHref="/zh/"
    homeAriaLabel="Volward 首页"
    navAriaLabel="主要导航"
    featuresLabel={copy.navFeatures}
    downloadLabel={copy.navDownload}
    localeToggleHref="/"
    localeToggleLabel={copy.localeToggle}
    logoSrc="/branding/volward-logo.svg"
  />

  <main>
    <Hero
      eyebrow={copy.heroEyebrow}
      title={copy.heroTitle}
      lead={copy.heroLead}
      ctaPrimary={copy.ctaDownload}
      ctaPrimaryHref="#download"
      ctaSecondary={copy.ctaLearn}
      ctaSecondaryHref="#features"
      wordmarkSrc="/branding/volward-wordmark.png"
      logoSrc="/branding/volward-logo.png"
      metaItems={heroMetaItems}
    />
    <Features
      title={copy.navFeatures}
      subtitle={copy.featureSectionTitle}
      lead={copy.featureSectionLead}
      features={copy.features}
    />
    <DownloadCards
      title={copy.downloadTitle}
      lead={copy.downloadLead}
      items={downloads}
      latestHref={GITHUB_RELEASES_URL}
      latestLabel={copy.downloadAllReleases}
      downloadPlatformAriaLabel={copy.downloadPlatformAriaLabel}
    />
    <ReleaseNotes title={copy.releaseLogTitle} items={releaseLogs} />
  </main>

  <Footer copy={copy.footerCopy} versionText={copy.footerVersion} unsignedText={copy.footerUnsigned} version="" />
</BaseLayout>
